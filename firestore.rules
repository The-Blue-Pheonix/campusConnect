rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ---------------- VALID STUDENTS (Gatekeeper Allowlist) ----------------
    match /valid_students/{docId} {
      allow read: if true; // Public read needed for login/signup verification
      allow update: if isAuthenticated();
    }

    // ---------------- USER PROFILES & SUBCOLLECTIONS ----------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Who Viewed Your Profile subcollection
      match /views/{viewerId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == viewerId);
        allow create, update: if isAuthenticated() && request.auth.uid == viewerId;
      }
    }

    // ---------------- FRIEND REQUESTS ----------------
    match /friend_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // ---------------- PRIVATE, GROUP & EPHEMERAL CHATS ----------------
    match /chats/{chatId} {

      // Read existing chat metadata
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.users;

      // Create new chat room (e.g., when a friend request is accepted)
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.users;

      // Update chat metadata (lastMessage, updatedAt)
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.users;

      // Chat Messages Subcollection
      match /messages/{messageId} {
        allow read, create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }

    // ---------------- ACTIVITIES / CLUB EVENTS ----------------
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Club leaders post events
    }

    // ---------------- TASK ASSIGNMENTS ----------------
    match /assignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }

    // ---------------- QR CHECKINS ----------------
    match /checkins/{activityId} {
      allow read, write: if isAuthenticated();
    }

    // ---------------- USER REPORTS ----------------
    match /reports/{reportId} {
      allow create: if isAuthenticated() 
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if false; // Only accessible via Firebase Admin SDK / Console
    }

  }
}